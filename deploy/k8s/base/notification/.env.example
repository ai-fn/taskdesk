# Notification-service SMTP secrets.
#
# Copy this file to `.env` (sibling of kustomization.yaml) and fill in the
# values. `.env` is gitignored — never commit real credentials.
#
#   cp deploy/k8s/base/notification/.env.example deploy/k8s/base/notification/.env
#
# Leave SMTP_USER and SMTP_PASS empty to use Mailpit (unauthenticated, dev only).
# Set both to enable smtp.PlainAuth for a real SMTP server.
#
# Gmail example:
#   SMTP_ADDR=smtp.gmail.com:587
#   SMTP_FROM=you@gmail.com
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<App Password from https://myaccount.google.com/apppasswords>
#
# Dev default (Mailpit inside the cluster — no auth needed):
SMTP_USER=
SMTP_PASS=
