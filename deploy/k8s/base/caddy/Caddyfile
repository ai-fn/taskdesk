# Caddy edge config for the todo app.
#
# Mounted into the Caddy pod as a ConfigMap generated by the
# kustomization.yaml in this directory. Edit freely — `kubectl apply -k`
# (or Tilt) will roll the pod and pick up changes.
#
# Phase 0: HTTP only, single backend (gateway).
# Phase 1: add /api/v1/* path → gateway, /ws → gateway WebSocket.
# Phase 5: add `tls internal` (Caddy's built-in CA) and switch to :443.

{
	# Disable automatic HTTPS in dev — kind doesn't expose 443 to a public IP
	# and we don't want Caddy trying to fetch real certs.
	auto_https off
	admin off
}

:80 {
	log {
		output stdout
		format json
	}

	# Health probe target so kubelet probes go through Caddy too.
	handle /caddy-health {
		respond "ok" 200
	}

	# API traffic → gateway service.
	handle /api/v1/* {
		reverse_proxy gateway.todo.svc.cluster.local:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else → the SPA (nginx serves index.html for all paths).
	handle {
		reverse_proxy web.todo.svc.cluster.local:80
	}
}
