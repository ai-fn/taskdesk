# AI-service secrets.
#
# Copy this file to `.env` (sibling of kustomization.yaml) and fill in the
# values. `.env` is gitignored — never commit real secrets.
#
#   cp deploy/k8s/base/ai/.env.example deploy/k8s/base/ai/.env
#
# Get your keys from:
#   ANTHROPIC_API_KEY: https://console.anthropic.com/settings/keys
#   VOYAGE_API_KEY:    https://dash.voyageai.com/api-keys   (optional;
#                      used for embeddings / semantic search)
#
# DATABASE_URL is the dev default — keep as-is unless you've changed the
# Postgres password in deploy/k8s/base/postgres/secret.yaml.

DATABASE_URL=postgres://postgres:devpassword@postgres.data.svc.cluster.local:5432/todo?sslmode=disable&x-migrations-table=ai_schema_migrations
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
