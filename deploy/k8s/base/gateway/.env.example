# Gateway OAuth credentials.
#
# Copy this file to `.env` (sibling of kustomization.yaml) and fill in the
# values. `.env` is gitignored — never commit real secrets.
#
#   cp deploy/k8s/base/gateway/.env.example deploy/k8s/base/gateway/.env
#
# Register the app in:
#   Google Cloud Console:    https://console.cloud.google.com/apis/credentials
#     Authorized redirect URI:
#       http://localhost:8080/api/v1/auth/oauth/google/callback
#   Discord Developer Portal: https://discord.com/developers/applications
#     Redirect URI:
#       http://localhost:8080/api/v1/auth/oauth/discord/callback
#
# Missing values mean the gateway logs a warning and skips that provider
# at startup; the OAuth button in the SPA will then hit a 404. Set both
# CLIENT_ID and CLIENT_SECRET for each provider you want enabled.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_BASE_URL=http://localhost:8080
# Set COOKIE_SECURE=true in the gateway env in production (implied by an https OAUTH_BASE_URL).
