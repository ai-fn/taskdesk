# Auth-service Stripe secrets.
#
# Copy this file to `.env` (sibling of kustomization.yaml) and fill in the
# values. `.env` is gitignored — never commit real credentials.
#
#   cp deploy/k8s/base/auth/.env.example deploy/k8s/base/auth/.env
#
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
# Get STRIPE_PRICE_ID from https://dashboard.stripe.com/test/products
#
# Leave STRIPE_SECRET_KEY empty to disable Stripe (checkout returns 501).
#
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173/upgrade?success=1
STRIPE_CANCEL_URL=http://localhost:5173/upgrade?canceled=1
