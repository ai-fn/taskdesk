# Local dev environment — sourced by direnv or manually: source .envrc
#
# GODEBUG=netdns=cgo: forces Go to use the OS/CGO DNS resolver instead of its
# pure-Go resolver, which is blocked on VPN setups that filter UDP port 53.
export GODEBUG=netdns=cgo
export GOPROXY=https://proxy.golang.org
export PATH="$HOME/.local/bin:$PATH"
