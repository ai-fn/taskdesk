# Tilt config — local dev loop on kind.
#
# What Tilt does for us:
#   1. Compiles the Go binary on the host (fast, uses host Go cache).
#   2. Packs it into a tiny alpine image and loads it into kind.
#   3. On subsequent saves: syncs only the binary + restarts the process
#      (no full image rebuild — typically ~2s loop).
#   4. Re-applies Kustomize manifests on YAML changes.
#   5. Surfaces logs from every pod in the Tilt UI (http://localhost:10350).
#
# Usage:
#   ./scripts/kind-up.sh    # one-time cluster setup
#   source .envrc           # sets GODEBUG=netdns=cgo for Go DNS on VPN
#   /usr/local/bin/tilt up  # start dev loop

load('ext://restart_process', 'docker_build_with_restart')

allow_k8s_contexts('kind-todo')

# Per-service secrets are now generated by Kustomize from <service>/.env files
# (gitignored). Copy each <service>/.env.example → <service>/.env and fill in
# values before `tilt up`. No Tilt-side patching needed.

# Common build flags
GO_BUILD_FLAGS = 'CGO_ENABLED=0 GOOS=linux'

# Dev Dockerfile template: alpine base required by restart_process extension.
def go_image(image_name, binary_path):
    return '''
FROM alpine:3.20
COPY {binary} /{binary_name}
USER 65534
ENTRYPOINT ["/{binary_name}"]
'''.format(binary=binary_path, binary_name=binary_path.split('/')[-1])

# ----------------------------------------------------------------------------
# Gateway
# ----------------------------------------------------------------------------
local_resource(
    'gateway-compile',
    cmd=GO_BUILD_FLAGS + ' go build -o build/gateway ./cmd/gateway',
    dir='services/gateway',
    deps=[
        'services/gateway/cmd',
        'services/gateway/internal',
        'services/gateway/go.mod',
        'pkg',
        'proto/gen',
    ],
    labels=['gateway'],
)

docker_build_with_restart(
    'todo/gateway',
    context='.',
    dockerfile_contents=go_image('todo/gateway', 'services/gateway/build/gateway'),
    entrypoint='/gateway',
    only=['services/gateway/build/gateway'],
    live_update=[
        sync('services/gateway/build/gateway', '/gateway'),
    ],
)

# ----------------------------------------------------------------------------
# Auth service
# ----------------------------------------------------------------------------
local_resource(
    'auth-compile',
    cmd=GO_BUILD_FLAGS + ' go build -o build/auth ./cmd/auth',
