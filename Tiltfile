# ----------------------------------------------------------------------------
# Web SPA
# NOTE: Full Docker rebuild (~45-90s) on every src change — use `npm run dev`
# (outside cluster) for active UI work. Tilt only for cluster smoke tests.
# ----------------------------------------------------------------------------
docker_build(
    'todo/web',
    context='web',
    dockerfile='web/Dockerfile',
    ignore=['node_modules', 'dist', '.vite'],
)

# ----------------------------------------------------------------------------
# Manifests
# ----------------------------------------------------------------------------
k8s_yaml(kustomize('deploy/k8s/base/caddy'))
k8s_yaml(kustomize('deploy/k8s/base/gateway'))
k8s_yaml(kustomize('deploy/k8s/base/auth'))
k8s_yaml(kustomize('deploy/k8s/base/todo'))
# Migration ConfigMap is generated directly from migrations/todo/ so new
# migration files are picked up automatically without editing kustomization.yaml.
# watch_file() makes Tilt re-evaluate the Tiltfile (and re-apply the ConfigMap)
# whenever any file in the migrations directory changes.
watch_file('migrations/todo')
k8s_yaml(local(
    'kubectl create configmap todo-migrations -n todo --from-file=migrations/todo/ --dry-run=client -o yaml',
))
k8s_yaml(kustomize('deploy/k8s/base/notification'))
k8s_yaml(kustomize('deploy/k8s/base/ai'))
k8s_yaml(kustomize('deploy/k8s/base/scheduler'))
k8s_yaml(kustomize('deploy/k8s/base/web'))
k8s_yaml(kustomize('deploy/k8s/base/minio'))

# ----------------------------------------------------------------------------
# Monitoring (Prometheus + Grafana) — monitoring namespace
# ----------------------------------------------------------------------------
k8s_yaml([
    'infra/prometheus/namespace.yaml',
    'infra/prometheus/rbac.yaml',
    'infra/prometheus/configmap.yaml',
    'infra/prometheus/deployment.yaml',
    'infra/prometheus/service.yaml',
    'infra/grafana/configmap.yaml',
    'infra/grafana/dashboard-provider-cm.yaml',
    'infra/grafana/dashboard-grpc-cm.yaml',
    'infra/grafana/dashboard-http-cm.yaml',
    'infra/grafana/deployment.yaml',
    'infra/grafana/service.yaml',
])

k8s_resource('caddy',                 labels=['edge'],         port_forwards=[])
k8s_resource('gateway',               labels=['gateway'],      resource_deps=['gateway-compile'])
k8s_resource('auth',                  labels=['auth'],         resource_deps=['auth-compile'])
k8s_resource('todo',                  labels=['todo'],         resource_deps=['todo-compile'])
k8s_resource('notification',          labels=['notification'], resource_deps=['notification-compile'])
k8s_resource('ai',                    labels=['ai'],           resource_deps=['ai-compile'])
k8s_resource('daily-plan-scheduler',  labels=['ai'],           resource_deps=['scheduler-compile'])
k8s_resource('web',                   labels=['web'])
k8s_resource('prometheus',            labels=['monitoring'])
k8s_resource('grafana',               labels=['monitoring'])
k8s_resource('minio',                 labels=['data'])

# ----------------------------------------------------------------------------
# ELK stack — monitoring namespace
# ----------------------------------------------------------------------------
k8s_yaml([
    'infra/elk/elasticsearch.yaml',
    'infra/elk/kibana.yaml',
    'infra/elk/filebeat-rbac.yaml',
    'infra/elk/filebeat-config-cm.yaml',
    'infra/elk/filebeat-daemonset.yaml',
])

k8s_resource('elasticsearch', labels=['monitoring'])
k8s_resource('kibana',        labels=['monitoring'])
k8s_resource('filebeat',      labels=['monitoring'])
